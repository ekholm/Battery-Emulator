# =============================================================================
# Battery-Emulator - flash-size sdkconfig overrides (pioarduino hybrid mode)
# Reference from platformio.ini:  custom_sdkconfig = file://sdkconfig.be_size.defaults
#
# Highest precedence in the pioarduino config chain, so these win over the
# Arduino framework defaults. Tailored to this firmware's actual usage:
#   - no BLE/Bluetooth        - no on-device Ethernet
#   - no on-device TLS client - uses WiFi STA + SoftAP (config portal)
#   - MQTT via esp-mqtt       - web UI via ESPAsyncWebServer (not IDF httpd)
# Run `pio run -t clean` after editing. Measure with the .map / size report.
# =============================================================================

# -----------------------------------------------------------------------------
# TIER 1 - safe, high value. Apply and measure first.
# -----------------------------------------------------------------------------

# Optimize for size. Critical in hybrid mode: without this the from-source IDF
# libs may build at -Og and REGRESS flash vs the precompiled ones.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set

# No Bluetooth anywhere in the app. Usually off already under Arduino-as-lib,
# but assert it so it can never get pulled in.
# CONFIG_BT_ENABLED is not set

# Strip IDF-component log strings (WiFi, esp-mqtt, lwIP, etc.) entirely. Your own
# logging/remote-syslog layer is separate and unaffected. Drop to _WARN instead
# of _NONE if you want to keep IDF-level warnings/errors for field diagnostics.
# NOTE: application log level only. The bootloader is deliberately NOT touched
# here (no CONFIG_BOOTLOADER_* overrides), so it stays at the framework default,
# identical to a pre-patch build.
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
# CONFIG_LOG_DEFAULT_LEVEL_WARN is not set
# CONFIG_LOG_DEFAULT_LEVEL_INFO is not set

# No WPA2/WPA3-Enterprise (you use plain PSK). Drops the enterprise supplicant.
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set

# Root-CA bundle: the FULL store is ~69 KB and this firmware does NO on-device
# TLS verification (the GitHub release check runs in the browser). The feature
# CANNOT be fully disabled: arduino-esp32's NetworkClientSecure library does an
# unconditional #include "esp_crt_bundle.h" (only present when the feature is on),
# and hybrid mode compiles that unused library from source. Plain NONE also fails
# to build (empty generation -> missing x509_crt_bundle.S).
# So: keep the feature ON, select NONE, and supply a custom bundle holding a
# single self-signed placeholder CA (Software/src/lib/dummy.pem). The generated
# blob is ~162 B instead of ~69 KB FULL / ~18 KB CMN. Path is relative to the
# project root (where platformio.ini lives).
# >>> Caveat: this dummy is the ONLY trusted root, so any real on-device TLS
#     verification (secure MQTT / a TLS client) would reject everything. If you
#     ever need that, switch back to CMN/FULL or point the path at your real CA.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_NONE=y
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL is not set
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN is not set
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="Software/src/lib/dummy.pem"

# -----------------------------------------------------------------------------
# HYBRID-MODE BUILD FIX (fallback / safety net)
# esp-modbus is now excluded via `custom_component_remove` in platformio.ini,
# so these two lines normally do nothing. They are kept as a safety net: if
# removing espressif/esp-modbus ever triggers a dependency error, drop it from
# the remove list and this pin keeps the from-source build green. The component
# ships a _Static_assert requiring
#   FMB_MASTER_MAX_API_BLOCKING_TIME_MS >= FMB_MASTER_TIMEOUT_MS_RESPOND,
# which the merged Arduino base config otherwise violates. Values are inert for
# this firmware (it uses the Arduino eModbus library, not espressif/esp-modbus).
CONFIG_FMB_MASTER_TIMEOUT_MS_RESPOND=5000
CONFIG_FMB_MASTER_MAX_API_BLOCKING_TIME_MS=6000
#   Nano printf drops %f support
CONFIG_NEWLIB_NANO_FORMAT=y

# -----------------------------------------------------------------------------
# TIER 2 - larger wins, validate the affected feature after enabling.
# -----------------------------------------------------------------------------

# mbedTLS is still linked (WiFi crypto + esp-mqtt's TLS transport), but you can
# shed protocol variants you never negotiate. TLS 1.3 + DTLS are the big ones.
# >>> Caveat: only safe if you don't use secure MQTT (port 8883). If secure MQTT
#     is a supported user option, test an 8883 broker before shipping these.
# CONFIG_MBEDTLS_SSL_PROTO_TLS1_3 is not set
# CONFIG_MBEDTLS_SSL_PROTO_DTLS is not set

# The ESP32 is never a TLS server (the web UI is plain HTTP over AsyncTCP), so
# drop the mbedTLS server-side code and keep only the client path.
# >>> Caveat: same as above - if you ever run an on-device TLS server, revert.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y

# Remove assertion checks outright (not just the message strings). Larger flash
# win than SILENT. Trade-off: a bug that would have cleanly asserted becomes
# undefined behaviour instead. Switch back to _SILENT if you want the aborts.
# CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
# CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT is not set

# -----------------------------------------------------------------------------
# TIER 3 - measure carefully, board-by-board. May interact with AsyncTCP / mDNS.
# -----------------------------------------------------------------------------

# IPv6 off saves flash, but ESPAsyncWebServer / AsyncTCPSock and mDNS sometimes
# assume IPv6 types are present. Enable ONLY if the web UI + mDNS still build and
# work on every target. Leave commented until you've tested it.
# # CONFIG_LWIP_IPV6 is not set

# -----------------------------------------------------------------------------
# LATENCY (not size) - what a firmware upload does to the CAN streams
# -----------------------------------------------------------------------------

# Erase in 4 KB sectors, never in 64 KB blocks.
#
# A flash erase is ATOMIC: the cache is off for the whole command, both cores
# are parked, and no task runs - so nothing sends a CAN frame and nothing drains
# a receive FIFO. The erase COMMAND is therefore the unit of CAN starvation, and
# the two available commands are an order of magnitude apart on this part: a
# 4 KB sector erase measures 16-24 ms, a 64 KB block erase 88 ms. Nothing can
# shorten a command once it has been issued - erase suspend is either absent
# (ESP32/LX6) or, where it exists, no better than sector erasing and unsafe on
# flash parts outside IDF's whitelist - so the only lever is which command the
# driver issues, which is what this option decides.
#
# It matters because the OTA path takes the block branch by default. Arduino's
# UpdateClass calls partitionEraseRange() for a whole SPI_FLASH_BLOCK_SIZE
# whenever at least that much of the image is left and the offset is on a block
# boundary (Updater.cpp, `block_erase`), so a ~1.9 MB upload is a train of 29
# block erases - one every 64 KB - and each one is a multi-hundred-millisecond
# hole in whatever the emulator was transmitting.
#
# 29 rather than 28, and the difference is the uploader: ElegantOTA calls
# Update.begin(UPDATE_SIZE_UNKNOWN), so `_size` is the PARTITION size and not
# the image size. Every block-aligned offset the upload reaches therefore has a
# whole block "left" behind it, the final partial block included, and the
# unaligned-partition branches (`part_head_sectors` / `part_tail_sectors`) never
# fire at all on a table whose app slots are on 64 KB boundaries. An uploader
# that passed the real content length would erase 28 blocks and finish the tail
# in sectors.
#
# MEASURED on a LilyGo T_2CAN pair (ESP32-S3) over a 500 kbit native link, one
# board transmitting a paced stream while it takes the upload and the other
# recording the interval between arrivals - the pack's view, which is the one a
# keepalive timeout is run against:
#
#   64 KB block erases (this option off), ~1.9 MB upload:
#     100 f/s offered:  worst 106.5 ms, 15 intervals over 100 ms, 0 frames lost
#    1000 f/s offered:  worst 101.2 ms,  6 intervals over 100 ms, 0 frames lost
#
#   4 KB sector erases (this option on), same rig, same image:
#     100 f/s offered:  worst  30.5 ms,  0 intervals over 100 ms, 0 frames lost
#    1000 f/s offered:  worst  29.0 ms,  0 intervals over 100 ms, 0 frames lost
#
#   The slower, more realistic cadence is the worse one without this option:
#   there are 29 block erases in an upload of this size, and at 10 ms between
#   frames half of them are long enough to be a breach on their own.
#
# The cost is real rather than slight, and it is the reason this is a deliberate
# trade and not a free win: erasing 64 KB as sixteen sector commands takes
# longer than one block command, so the upload runs slower. Measured on the same
# legs: 11.1-11.4 s becomes 18.2-18.9 s for a 1.89 MB image, about 64 % longer,
# paid once per firmware update.
#
# That is the trade this firmware wants. It is a battery emulator on a live bus
# and a late keepalive outranks a fast upload, and the exposure is bounded to
# the upload itself: every other flash write this firmware makes is an NVS
# settings write, which erases a single sector and takes the sector branch with
# or without this option.
CONFIG_SPI_FLASH_BYPASS_BLOCK_ERASE=y



# -----------------------------------------------------------------------------
# Keep GPIO interrupt dispatch alive while the flash cache is disabled.
#
# With this OFF, the Arduino GPIO ISR service is not IRAM-resident, so every INT
# arriving during an NVS commit or an OTA write is MASKED until the window ends
# - silent CAN FIFO loss. With it ON the dispatcher runs through those windows,
# which is only safe if every registered handler AND everything it calls is
# IRAM-resident; otherwise the masked interrupt becomes a cache-off fetch, i.e.
# a crash instead of data loss.
#
# MERGE GATE - this flag ships only with handlers that are IRAM-resident all
# the way down. On this base there are exactly TWO attachInterrupt registration
# sites, both vendored, zero project-level users:
#   - mcp2515_lite's mcp2515_isr_handler: IRAM_ATTR, safe.
#   - ACAN2517FD: comm_can.cpp registers IRAM_ATTR trampolines that call the
#     library's isr(), itself IRAM_ATTR on the ESP32 build; the only thing
#     below that is xSemaphoreGiveFromISR and the yield, both resident. (A
#     polled drain once removed this registration instead, and reboot-looped
#     the board under ordinary receive load - the library's no-interrupt mode
#     polls from inside receive()'s own SPI transaction and deadlocks the
#     caller on the framework's SPI mutex. The interrupt is back, resident.)
# That residency condition is CHECKED BY CI, not remembered: the firmware-build
# job runs tools/isr_iram_audit.py on every env's linked image, walking the GPIO
# dispatcher and all three CAN interrupt paths, and fails the build naming any
# callee it finds in .flash.text. It decides from the IMAGE whether this flag is
# in effect - the flag's whole effect is that Arduino's __onPinInterrupt is
# IRAM-resident - so carrying the flag to a new env needs nothing added to any
# list, and an image built without it is skipped rather than failed. What DOES
# need a human is a change to how an interrupt is REGISTERED: the audit fails
# loudly, rather than passing vacuously, when a root it expects is gone.
# -----------------------------------------------------------------------------
CONFIG_ARDUINO_ISR_IRAM=y
